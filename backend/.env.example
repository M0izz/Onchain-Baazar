# Onchain Bazaar — Backend Indexer Environment
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ─────────────────────────────────────────────
# BSC TESTNET RPC
# ─────────────────────────────────────────────
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/

# ─────────────────────────────────────────────
# BSCSCAN API KEY (get free at bscscan.com/myapikey)
# ─────────────────────────────────────────────
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ─────────────────────────────────────────────
# DEPLOYED CONTRACT ADDRESSES (from contracts/deployments.json)
# ─────────────────────────────────────────────
ALTANA_SESSION_MANAGER=
SYRUP_SENTINEL=
VENUS_GUARDIAN=
YIELD_MAX=
CHAIN_WATCH=

# ─────────────────────────────────────────────
# SERVER SETTINGS
# ─────────────────────────────────────────────
POLL_INTERVAL_SECONDS=15
CACHE_TTL_SECONDS=10
PORT=8000

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL via asyncpg)
# Railway provides this automatically — format:
#   postgresql+asyncpg://user:pass@host:port/db
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/onchain_bazaar

# ─────────────────────────────────────────────
# JWT AUTH
# ─────────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────────
# EMAIL (Resend — resend.com, free 3k/month)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_DOMAIN=onchainbazaar.xyz

# ─────────────────────────────────────────────
# FRONTEND URL (for password-reset links in emails)
# ─────────────────────────────────────────────
FRONTEND_URL=https://your-site.netlify.app
