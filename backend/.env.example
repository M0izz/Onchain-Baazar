# Onchain Bazaar — Backend Indexer Environment
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ─────────────────────────────────────────────
# BSC TESTNET RPC
# ─────────────────────────────────────────────
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/

# ─────────────────────────────────────────────
# BSCSCAN API KEY (get free at bscscan.com/myapikey)
# ─────────────────────────────────────────────
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ─────────────────────────────────────────────
# DEPLOYED CONTRACT ADDRESSES (from contracts/deployments.json)
# ─────────────────────────────────────────────
ALTANA_SESSION_MANAGER=
SYRUP_SENTINEL=
VENUS_GUARDIAN=
YIELD_MAX=
CHAIN_WATCH=

# ─────────────────────────────────────────────
# SERVER SETTINGS
# ─────────────────────────────────────────────
# How often the indexer polls the RPC for new events (seconds)
POLL_INTERVAL_SECONDS=15

# BscScan response cache TTL (seconds)
CACHE_TTL_SECONDS=10

# Port for uvicorn to listen on
PORT=8000
