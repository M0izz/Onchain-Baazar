{
  "name": "onchain-bazaar-contracts",
  "version": "1.0.0",
  "description": "Smart contracts suite for Onchain Bazaar ERC-8004 AI Agent Marketplace on BSC Testnet",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node:start": "npx hardhat node",
