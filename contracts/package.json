    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "sync:addresses": "node scripts/sync-addresses.js",
    "verify:testnet": "node scripts/verify.js"
  },
  "keywords": [
    "erc-8004",
    "bnb-chain",
    "altana",
    "pancakeswap",
    "ai-agents"
  ],
