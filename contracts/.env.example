# Onchain Bazaar — Contracts Environment
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ─────────────────────────────────────────────
# DEPLOYER WALLET
# ─────────────────────────────────────────────
# Private key of the BSC Testnet deployer wallet (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# ─────────────────────────────────────────────
# BSC TESTNET RPC
# ─────────────────────────────────────────────
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/

# Fallback RPCs (if primary is slow):
# https://data-seed-prebsc-2-s1.binance.org:8545/
# https://data-seed-prebsc-1-s2.binance.org:8545/

# ─────────────────────────────────────────────
# BSCSCAN TESTNET API KEY
# Get free key at: https://bscscan.com/myapikey
# ─────────────────────────────────────────────
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ─────────────────────────────────────────────
# DEPLOYED CONTRACT ADDRESSES (auto-populated by deploy.js)
# ─────────────────────────────────────────────
ALTANA_SESSION_MANAGER=
SYRUP_SENTINEL=
VENUS_GUARDIAN=
YIELD_MAX=
CHAIN_WATCH=
